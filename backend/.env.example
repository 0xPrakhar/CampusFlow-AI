PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL / Neon. Copy the full URI from Neon Connect; never commit its password.
DATABASE_URL=

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Set mock for an end-to-end local demo. Set live to call an OpenAI-compatible API.
AI_MODE=mock
AI_API_KEY=sk-or-v1-
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1

# Set true after adding the required properties to your Notion database.
NOTION_ENABLED=false
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name

# Used by `npm run db:seed-staff`.
STAFF_USERNAME=campusadmin
STAFF_EMAIL=admin@campusflow.ai
STAFF_FULL_NAME=Campus Admin
STAFF_PASSWORD=Admin@123
